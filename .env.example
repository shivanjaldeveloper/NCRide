# Copy this file to .env and fill in real values. .env itself is
# gitignored and must never be committed — this .example file is the
# only one that should be pushed, so teammates know which vars to set.

API_BEARER_TOKEN=your_aloapp_shop_bearer_token_here
GOOGLE_MAPS_API_KEY=your_google_places_api_new_key_here
SHARED_SECRET=REPLACE_ME_WITH_ALOAPP_SHOP_SHARED_SECRET
